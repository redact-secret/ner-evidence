    {
      "id": "linguistic-independent-review",
      "description": "Cases whose linguistic expectation was independently reviewed",
      "where": {
        "review_linguistic": "independently-reviewed"
      },
      "min": 100,
      "waiver": "No independent reviewer was available while the Alpha corpus was authored by a single author session, so every case is author-only. This is reported in the snapshot review_summary; Beta must close it."
    },
    {
      "id": "factual-independent-review",
      "description": "Cases whose factual claims were independently reviewed",
      "where": {
        "review_factual": "independently-reviewed"
      },
      "min": 100,
      "waiver": "No independent reviewer was available while the Alpha corpus was authored by a single author session, so every case is author-only. This is reported in the snapshot review_summary; Beta must close it."
    }
  ],
  "ratio_targets": [
    {
      "id": "en-share",
      "description": "English share of all cases stays between 40% and 60%",
      "numerator": {
        "language": "en"
      },
      "denominator": {},
      "min": 0.4,
      "max": 0.6
    },
    {
      "id": "en-unseen-share",
      "description": "Unseen share of EN name-bearing cases (rare+novel over common+rare+novel)",
      "numerator": {
        "language": "en",
        "seen": "unseen"
      },
      "denominator": {
        "language": "en",
        "seen": [
          "seen",
          "unseen"
        ]
      },
      "min": 0.25
    },
    {
      "id": "en-ambiguous-share",
      "description": "Ambiguous share of EN cases",
      "numerator": {
        "language": "en",
        "ambiguity": "ambiguous"
      },
      "denominator": {
        "language": "en"
      },
      "min": 0.35
    },
    {
      "id": "en-not-person-share",
      "description": "Share of EN cases containing a not-person span",
      "numerator": {
        "language": "en",
        "kinds": "not-person"
      },
      "denominator": {
        "language": "en"
      },
      "min": 0.25
    },
    {
      "id": "ko-unseen-share",
      "description": "Unseen share of KO name-bearing cases (rare+novel over common+rare+novel)",
      "numerator": {
        "language": "ko",
        "seen": "unseen"
      },
      "denominator": {
        "language": "ko",
        "seen": [
          "seen",
          "unseen"
        ]
      },
      "min": 0.25
    },
    {
      "id": "ko-ambiguous-share",
      "description": "Ambiguous share of KO cases",
      "numerator": {
        "language": "ko",
        "ambiguity": "ambiguous"
      },
      "denominator": {
        "language": "ko"
      },
      "min": 0.35
    },
    {
      "id": "ko-not-person-share",
      "description": "Share of KO cases containing a not-person span",
      "numerator": {
        "language": "ko",
        "kinds": "not-person"
      },
      "denominator": {
        "language": "ko"
      },
      "min": 0.25
    },
    {
      "id": "en-multi-share",
      "description": "Multi-token share of EN cases",
      "numerator": {
        "language": "en",
        "token_class": "multi"
      },
      "denominator": {
        "language": "en"
      },
      "min": 0.25
    },
    {
      "id": "ko-multi-share",
      "description": "Multi-token share of KO cases (Korean names are usually written without spaces, so the floor is structural)",
      "numerator": {
        "language": "ko",
        "token_class": "multi"
      },
      "denominator": {
        "language": "ko"
      },
      "min": 0.12
    },
    {
      "id": "easy-control-ceiling",
      "description": "Easy controls (common, unambiguous) must not dominate: at most 35% of all cases",
      "numerator": {
        "familiarity": "common",
        "ambiguity": "unambiguous"
      },
      "denominator": {},
      "max": 0.35
    }
  ],
  "known_gaps": [
    {
      "id": "no-independent-review",
      "description": "Every case has linguistic and factual review status author-only. Korean cases in particular need review by a native speaker or linguist, and English boundary conventions need a second annotator."
    },
    {
      "id": "synthetic-only-no-corpus-backing",
      "description": "All evidence is project-authored. No naturally occurring text is included, so the distribution of contexts, name frequencies and noise in real documents is not represented. Results on this corpus must not be read as real-world accuracy."
    },
    {
      "id": "familiarity-labels-unverified",
      "description": "The common/rare/novel familiarity labels are author judgments, not checked against national name-frequency tables. The seen/unseen slices are proxies; they say nothing about any model's training data."
    },
    {
      "id": "single-author-selection-bias",
      "description": "Cases reflect one author's view of what is confusable. Collision breadth (months, flowers, brands, districts) is illustrative, not a sampled or exhaustive list."
    },
    {
      "id": "no-inter-annotator-agreement",
      "description": "Span boundary conventions (titles, possessives, Korean particles and honorifics) were applied consistently by one author; agreement with an independent annotator has not been measured."
    },
    {
      "id": "plural-and-family-references-undefined",
      "description": "Plural and family references (the Joneses, two Johns, the Smiths' house) have no span convention in taxonomy 0.1.0. The 3 cases that use them, plus 1 ampersand-couple case, are marked either; they are not a test of correctness until a convention exists."
    },
    {
      "id": "scripts-beyond-latin-hangul-han",
      "description": "No Cyrillic, Arabic, Devanagari, Thai or other scripts, and no Japanese kana. Han coverage is limited to Korean hanja notation; Chinese and Japanese naming is out of scope."
    },
    {
      "id": "north-korean-and-diaspora-orthography",
      "description": "Korean cases follow contemporary South Korean spelling and spacing. North Korean orthography, older spellings and diaspora romanization variants are not covered."
    },
    {
      "id": "handles-usernames-email-local-parts",
      "description": "Usernames, social handles and email local parts that embed names are out of scope for taxonomy 0.1.0."
    },
    {
      "id": "small-eponym-and-work-title-slices",
      "description": "Eponym (Ohm's law, Nobel Prize) and work-title (novel, song, film) slices are present but small (single digits per language). They flag the problem but do not support per-slice conclusions."
    },
    {
      "id": "wrapper-projections-only",
      "description": "Fixtures are structural wrappers of the authored sentence (quote, log line, JSON, email, NFD). There are no noisy-text projections (typos, OCR errors, casing mutations) because each needs per-case semantic review."
    },
    {
      "id": "fixture-correlation",
      "description": "Fixtures derived from one case are correlated. Counting fixtures instead of cases overweights cases that accept more projections (Korean cases accept the NFD projection; English mostly do not)."
    }
  ]
}
