    {
      "id": "boundary-tagged-en",
      "description": "EN cases with at least one non-trivial boundary tag",
      "where": {
        "language": "en",
        "boundary_tags": [
          "punctuation-adjacent",
          "quote-boundary",
          "hyphen-boundary",
          "apostrophe-boundary",
          "honorific-excluded",
          "adjacent-names",
          "no-space",
          "comma-inverted",
          "parenthetical-boundary",
          "abbreviation-period",
          "digit-adjacent",
          "decomposition-sensitive"
        ]
      },
      "min": 80
    },
    {
      "id": "boundary-tagged-ko",
      "description": "KO cases with at least one non-trivial boundary tag",
      "where": {
        "language": "ko",
        "boundary_tags": [
          "particle-excluded",
          "suffix-excluded",
          "honorific-excluded",
          "adjacent-names",
          "no-space",
          "extra-spacing",
          "hyphen-boundary",
          "punctuation-adjacent",
          "quote-boundary",
          "parenthetical-boundary",
          "mixed-script-boundary",
          "digit-adjacent"
        ]
      },
      "min": 150
