{
  "targets_version": "1.0.0",
  "count_targets": [
    {
      "id": "en-cases",
      "description": "EN cases in total",
      "where": {
        "language": "en"
      },
      "min": 200
    },
    {
      "id": "ko-cases",
      "description": "KO cases in total",
      "where": {
        "language": "ko"
      },
      "min": 200
    },
    {
      "id": "en-unseen",
      "description": "EN cases whose focus name is rare or novel (unseen proxy)",
      "where": {
        "language": "en",
        "seen": "unseen"
      },
      "min": 60
    },
    {
      "id": "en-seen",
      "description": "EN cases whose focus name is common (seen proxy)",
      "where": {
        "language": "en",
        "seen": "seen"
      },
      "min": 100
