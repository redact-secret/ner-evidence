{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ner-evidence:schema:case-file:1.0.0",
  "title": "Authored case file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
